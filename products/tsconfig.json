{
"compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es6",
    "noImplicitAny": true,
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "build",
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
        "*": [
            "node_modules/*"
        ],
        "@root/*":["./*"],
        "@src/*": [ "./src/*" ],
        "@globalMiddleware/*": [ "./src/Middlewares/*" ],
    }
},
"include": [
    "./**/*"
]

}